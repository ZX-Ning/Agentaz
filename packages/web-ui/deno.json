{
    "name": "@agentaz/web-ui",
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "dom.asynciterable", "esnext"]
    },
    "exports": "./src/main.ts",
    "publish": false,
    "imports": {
        "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
        "vite": "npm:vite@^8.1.4",
        "vue-tsc": "npm:vue-tsc@^3.3.7",
        "vue": "npm:vue@^3.5.39",
        "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@^6.0.7",
        "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.2",
        "reka-ui": "npm:reka-ui@^2.10.1",
        "lucide-vue-next": "npm:lucide-vue-next@^0.468.0",
        "vue-sonner": "npm:vue-sonner@^2.0.9",
        "@comark/vue": "npm:@comark/vue@^0.4.0",
        "katex": "npm:katex@^0.16.47",
        "shiki": "npm:shiki@^4.3.1",
        "@fontsource-variable/ibm-plex-sans": "npm:@fontsource-variable/ibm-plex-sans@^5.2.8",
        "tailwindcss": "npm:tailwindcss@^4.3.2"
    },
    "tasks": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build --outDir ../../build/dist --emptyOutDir",
        "typecheck": "deno run -A npm:vue-tsc --noEmit -p tsconfig.json && deno check ."
    }
}
